{
  "name": "@racontine/server",
  "private": true,
  "version": "1.30.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:integration": "node --import tsx integration/adapters.ts",
    "test:privacy": "node --import tsx integration/privacy.ts",
    "test:privacy:http": "node --import tsx integration/privacy-http.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "yazl": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "yauzl": "^3.4.0"
  }
}
